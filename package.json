{
  "name": "codex-local-gateway",
  "version": "0.1.0",
  "description": "A guarded MCP gateway from ChatGPT and Codex clients to local workspaces, Codex tasks, and native development tools.",
  "type": "module",
  "private": false,
  "packageManager": "bun@1.3.13",
  "bin": {
    "codex-local-gateway": "./src/server.mjs"
  },
  "scripts": {
    "start": "bun run src/server.mjs --transport stdio",
    "start:http": "bun run src/server.mjs --transport http --host 127.0.0.1 --port 8787",
    "doctor": "bun run scripts/doctor.ts",
    "smoke:live": "bun run scripts/smoke-live.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "verify": "bun run typecheck && bun test && bun run doctor --strict",
    "build": "bun build src/server.mjs --compile --outfile dist/codex-local-gateway"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.5",
    "hono": "4.12.34"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "chatgpt",
    "codex",
    "mcp",
    "xcode",
    "local-development"
  ],
  "license": "MIT"
}
