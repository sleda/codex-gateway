{
  "mcpServers": {
    "codex-gateway": {
      "command": "bun",
      "args": ["run", "src/server.mjs", "--transport", "stdio"],
      "cwd": ".",
      "env_vars": [
        "CODEX_GATEWAY_ROOT",
        "CODEX_GATEWAY_TOKEN",
        "CODEX_GATEWAY_ALLOW_WRITES",
        "CODEX_GATEWAY_ALLOW_COMMANDS",
        "CODEX_GATEWAY_ALLOW_SENSITIVE_WRITES",
        "CODEX_GATEWAY_ALLOW_EXTERNAL_PATHS",
        "CODEX_GATEWAY_ALLOW_NONLOCAL_BIND",
        "CODEX_GATEWAY_COMMAND_ALLOWLIST",
        "CODEX_GATEWAY_ENABLE_CODEX",
        "CODEX_GATEWAY_ALLOW_CODEX_MUTATIONS",
        "CODEX_GATEWAY_CODEX_COMMAND",
        "CODEX_GATEWAY_SKILL_ROOTS",
        "CODEX_GATEWAY_XCODE_DEVELOPER_DIR",
        "CODEX_GATEWAY_PROFILE",
        "CODEX_GATEWAY_PROFILE_DIR"
      ]
    }
  }
}
