{
  "mcpServers": {
    "codex-local-gateway": {
      "command": "bun",
      "args": ["run", "src/server.mjs", "--transport", "stdio"],
      "cwd": ".",
      "env_vars": [
        "CODEX_LOCAL_GATEWAY_ROOT",
        "CODEX_LOCAL_GATEWAY_TOKEN",
        "CODEX_LOCAL_GATEWAY_ALLOW_WRITES",
        "CODEX_LOCAL_GATEWAY_ALLOW_COMMANDS",
        "CODEX_LOCAL_GATEWAY_ALLOW_SENSITIVE_WRITES",
        "CODEX_LOCAL_GATEWAY_ALLOW_EXTERNAL_PATHS",
        "CODEX_LOCAL_GATEWAY_ALLOW_NONLOCAL_BIND",
        "CODEX_LOCAL_GATEWAY_COMMAND_ALLOWLIST",
        "CODEX_LOCAL_GATEWAY_ENABLE_CODEX",
        "CODEX_LOCAL_GATEWAY_ALLOW_CODEX_MUTATIONS",
        "CODEX_LOCAL_GATEWAY_CODEX_COMMAND",
        "CODEX_LOCAL_GATEWAY_ENABLE_XCODE",
        "CODEX_LOCAL_GATEWAY_XCODE_COMMAND",
        "XCODEBUILDMCP_ENABLED_WORKFLOWS"
      ]
    }
  }
}
