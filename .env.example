CODEX_GATEWAY_ROOT=/absolute/path/to/permission-root
# Optional additional permission roots. Individual calls can select a repository
# under these grants with the workspace field.
CODEX_GATEWAY_WORKSPACE_ROOTS=/optional/project-parent:/another/grant
CODEX_GATEWAY_ENABLE_CODEX=1
# Optional colon-separated override. Defaults include workspace, user, Codex,
# and installed plugin skill roots.
CODEX_GATEWAY_SKILL_ROOTS=/optional/skill/root:/another/root
# Optional cache locations / refresh interval. Caches are fingerprinted and
# automatically refreshed; set these only when custom placement is required.
CODEX_GATEWAY_PROTOCOL_CACHE_DIR=~/.cache/codex-gateway/protocol
CODEX_GATEWAY_SKILL_CACHE_DIR=~/.cache/codex-gateway/skills
CODEX_GATEWAY_SKILL_CACHE_TTL_MS=60000

# Optional full Xcode toolchain override. When omitted, Gateway discovers valid
# Xcode/Xcode Beta bundles without changing the machine-wide xcode-select value.
CODEX_GATEWAY_XCODE_DEVELOPER_DIR=/Applications/Xcode-beta.app/Contents/Developer

# Mutating surfaces are independent and disabled unless explicitly enabled.
CODEX_GATEWAY_ALLOW_WRITES=0
CODEX_GATEWAY_ALLOW_COMMANDS=0
CODEX_GATEWAY_ALLOW_CODEX_MUTATIONS=0

# Required only for direct HTTP mode. Secure MCP Tunnel normally uses stdio.
CODEX_GATEWAY_TOKEN=replace-with-a-high-entropy-secret
