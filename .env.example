CODEX_LOCAL_GATEWAY_ROOT=/absolute/path/to/workspace
CODEX_LOCAL_GATEWAY_ENABLE_CODEX=1
CODEX_LOCAL_GATEWAY_ENABLE_XCODE=1

# Mutating surfaces are independent and disabled unless explicitly enabled.
CODEX_LOCAL_GATEWAY_ALLOW_WRITES=0
CODEX_LOCAL_GATEWAY_ALLOW_COMMANDS=0
CODEX_LOCAL_GATEWAY_ALLOW_CODEX_MUTATIONS=0

# Required only for direct HTTP mode. Secure MCP Tunnel normally uses stdio.
CODEX_LOCAL_GATEWAY_TOKEN=replace-with-a-high-entropy-secret
